{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and pet windows",
  "windows": ["main", "pet"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "dialog:default"
  ]
}
